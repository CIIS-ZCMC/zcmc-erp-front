{
  "compilerOptions": {
    "baseUrl": ".",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "paths": {
      "@Components/*": ["src/Components/*"],
      "@Pages/*": ["src/Pages/*"],
      "@Layout/*": ["src/Layout/*"],
      "@Hooks/*": ["src/Hooks/*"],
      "@Data/*": ["src/Data/*"],
      "@Utils/*": ["src/Utils/*"],
      "@Store/*": ["src/Store/*"],
      "@Services/*": ["src/Services/*"],
      "@Routes/*": ["src/Routes/*"]
    }
  },
  "exclude": ["node_modules", "dist"]
}
